{
  "name": "gsu-cetloe/cetloelib-php",
  "description": "Shared PHP library for CETLOE applications: DI container, console, HTTP client, logging, and utilities.",
  "license": "MIT",
  "homepage": "https://github.com/GSU-CETLOE/cetloelib-php",
  "require": {
    "php": "^8.1",
    "ext-dom": "*",
    "guzzlehttp/guzzle": "^7.8",
    "guzzlehttp/psr7": "^2.6",
    "monolog/monolog": "^3.5",
    "php-di/php-di": "^7.0",
    "psr/log": "^3.0",
    "symfony/console": "^6.3.8",
    "symfony/dotenv": "^6.3"
  },
  "require-dev": {
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-deprecation-rules": "^1.1",
    "phpstan/phpstan-strict-rules": "^1.5",
    "squizlabs/php_codesniffer": "^3.8"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Cetloe\\": "src/"
    }
  },
  "scripts": {
    "phpcs": "vendor/bin/phpcs",
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G"
  }
}
